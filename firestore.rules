// Generado automáticamente a partir de PERMISSION_MATRIX.
// NO editar a mano: los cambios deben hacerse en domain/rbac/rbac-engine.ts.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla temporal de desarrollo: permite lectura/escritura a usuarios autenticados.
    // TODO: Reemplazar con reglas granulares generadas por PERMISSION_MATRIX cuando
    // los repositorios de servidor usen firebase-admin (que bypassa reglas).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
