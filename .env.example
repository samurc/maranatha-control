# Variables de entorno de Maranatha Control (Requerimiento 24.4).
#
# Copia este archivo a `.env.local` y reemplaza cada valor de marcador de
# posición con el valor real de tu propio proyecto de Firebase. Ver el
# README ("Configuración del entorno de Firebase") para el origen exacto
# de cada valor y los pasos de configuración.
#
# NUNCA subas `.env.local` (ni ningún archivo `.env*` real) al control de
# versiones: ya está excluido por `.gitignore`.

# --- SDK cliente de Firebase (Requerimiento 24.1) ---
# Estas 6 variables llevan el prefijo NEXT_PUBLIC_ porque Next.js las
# incluye en el bundle del navegador: NO deben contener secretos. Se
# obtienen desde la configuración del SDK web de tu proyecto de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key-de-firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Credenciales de servicio de firebase-admin (Requerimiento 24.2) ---
# Estas 3 variables NUNCA deben llevar el prefijo NEXT_PUBLIC_: contienen
# credenciales privilegiadas y solo deben usarse en código de servidor
# (Requerimiento 24.3). Se obtienen generando una clave de cuenta de
# servicio nueva desde la consola de Firebase.
FIREBASE_ADMIN_PROJECT_ID=tu-proyecto-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
